PORT=8000
HOST=0.0.0.0
# Neon PostgreSQL — use the pooled connection string from https://console.neon.tech
# Example: postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
CORS_ORIGIN="http://localhost:5173"

# Auth (change JWT_SECRET in production)
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Freshdesk
FRESHDESK_DOMAIN="your-company"
FRESHDESK_API_KEY="your_api_key_here"
FRESHDESK_WEBHOOK_SECRET="your_webhook_secret_here"

# Google Gemini (chat + knowledge-base embeddings)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"
