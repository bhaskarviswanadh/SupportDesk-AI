PORT=8000
HOST=0.0.0.0
DATABASE_URL="file:./tickets.db"
CORS_ORIGIN="http://localhost:5173"

# Auth (change JWT_SECRET in production)
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Freshdesk
FRESHDESK_DOMAIN="your-company"
FRESHDESK_API_KEY="your_api_key_here"
FRESHDESK_WEBHOOK_SECRET="your_webhook_secret_here"

# Hugging Face Inference API
HF_API_TOKEN="hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
HF_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Google Gemini (Ask Assistant chat)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.8-flash"
